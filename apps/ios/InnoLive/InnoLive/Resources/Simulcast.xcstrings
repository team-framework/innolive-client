{
  "sourceLanguage": "ko",
  "strings": {
    "방송할 플랫폼을 하나 이상 선택해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송할 플랫폼을 하나 이상 선택해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one broadcast platform."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信先を1つ以上選択してください。"
          }
        }
      }
    },
    "방송 제어를 완료하지 못했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송 제어를 완료하지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete the broadcast action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信の操作を完了できませんでした。"
          }
        }
      }
    },
    "송출할 플랫폼": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "송출할 플랫폼"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast destinations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信先"
          }
        }
      }
    },
    "계정 연결 필요": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 연결 필요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの連携が必要です"
          }
        }
      }
    },
    "설정을 편집할 플랫폼": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 편집할 플랫폼"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit platform settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を編集する配信先"
          }
        }
      }
    },
    "준비된 플랫폼으로 계속": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 플랫폼으로 계속"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with ready platforms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備済みの配信先で続ける"
          }
        }
      }
    },
    "계속해도 바로 방송이 시작되지 않습니다. 방송 시작을 눌러 공개하세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속해도 바로 방송이 시작되지 않습니다. 방송 시작을 눌러 공개하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing does not start a broadcast. Tap Start broadcast to go live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるだけでは配信は始まりません。「配信開始」を押して公開してください。"
          }
        }
      }
    },
    "일시 중지": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止"
          }
        }
      }
    },
    "재개": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開"
          }
        }
      }
    },
    "송출 종료": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "송출 종료"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop streaming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信終了"
          }
        }
      }
    },
    "전체 방송 종료": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 방송 종료"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop all broadcasts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての配信を終了"
          }
        }
      }
    },
    "준비된 플랫폼의 방송을 시청자에게 공개합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 플랫폼의 방송을 시청자에게 공개합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make broadcasts on the ready platforms live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備済みの配信先で視聴者に配信を公開します。"
          }
        }
      }
    },
    "라이브 시작에 실패했습니다. 다른 플랫폼의 방송은 유지됩니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 시작에 실패했습니다. 다른 플랫폼의 방송은 유지됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not go live. Broadcasts on other platforms continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信を開始できませんでした。他の配信先での配信は継続します。"
          }
        }
      }
    },
    "라이브 시작 실패": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 시작 실패"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go live failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信開始失敗"
          }
        }
      }
    },
    "준비된 대상 다시 시작": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 대상 다시 시작"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start remaining ready targets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備済みの配信先を再度開始"
          }
        }
      }
    },
    "준비 완료": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비 완료"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了"
          }
        }
      }
    },
    "실패한 플랫폼 다시 준비": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 플랫폼 다시 준비"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry failed platforms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した配信先を再準備"
          }
        }
      }
    }
  },
  "version": "1.0"
}
