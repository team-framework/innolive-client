          }
        }
      }
    },
    "차감 시간": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차감 시간"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消費時間"
          }
