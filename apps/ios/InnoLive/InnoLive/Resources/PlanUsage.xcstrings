{
  "sourceLanguage": "ko",
  "strings": {
    "이번 방송 최대 시간은 월 잔여 시간과 1회 한도 중 작은 값입니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 방송 최대 시간은 월 잔여 시간과 1회 한도 중 작은 값입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum for this broadcast is the smaller of your monthly remaining time and per-broadcast limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回の配信上限は、月の残り時間と1回の上限のうち短い方です。"
          }
        }
      }
    },
    "이번 방송 최대": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 방송 최대"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum for this broadcast"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回の配信上限"
          }
        }
      }
    },
    "방송별 사용 내역": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송별 사용 내역"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast usage history"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信ごとの使用履歴"
          }
        }
      }
    },
    "실제 방송 시간": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 방송 시간"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast time"
          }
        },
        "ja": {
