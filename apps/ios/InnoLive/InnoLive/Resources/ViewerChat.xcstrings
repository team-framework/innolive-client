    },
    "보기 전용 · 비공개 방송의 채팅은 표시되지 않을 수 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 전용 · 비공개 방송의 채팅은 표시되지 않을 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View only · Chat may be unavailable for private broadcasts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧専用 · 非公開配信のチャットは表示されない場合があります。"
          }
        }
      }
    },
    "채팅을 불러오지 못했습니다.": {
