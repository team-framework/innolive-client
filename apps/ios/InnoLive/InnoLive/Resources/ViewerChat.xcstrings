{
  "sourceLanguage": "ko",
  "strings": {
    "시청자 채팅": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자 채팅"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewer chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者チャット"
          }
        }
      }
    },
    "보기 전용 · 비공개 방송의 채팅은 표시되지 않을 수 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 전용 · 비공개 방송의 채팅은 표시되지 않을 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View only · Chat may be unavailable for private broadcasts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧専用 · 非公開配信のチャットは表示されない場合があります。"
          }
        }
      }
    },
    "채팅을 불러오지 못했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 불러오지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを読み込めませんでした。"
          }
        }
      }
    },
    "YouTube 방송을 시작하면 시청자 채팅을 볼 수 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 방송을 시작하면 시청자 채팅을 볼 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a YouTube broadcast to view audience chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube配信を開始すると視聴者チャットを表示できます。"
          }
        }
      }
    },
    "시청자 채팅은 YouTube 방송에서 지원합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자 채팅은 YouTube 방송에서 지원합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewer chat is available for YouTube broadcasts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者チャットはYouTube配信に対応しています。"
          }
        }
      }
    },
    "방송의 채팅 정보를 아직 받지 못했습니다. 정보가 도착하면 채팅을 표시합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송의 채팅 정보를 아직 받지 못했습니다. 정보가 도착하면 채팅을 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat information has not arrived yet. Chat will appear when it is available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信のチャット情報をまだ受信していません。情報を受信するとチャットを表示します。"
          }
        }
      }
    },
    "새 채팅을 기다리고 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 채팅을 기다리고 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for new messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャットを待っています。"
          }
        }
      }
    },
    "채팅을 연결하고 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 연결하고 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to chat…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットに接続しています…"
          }
        }
      }
    },
    "채팅 표시": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 표시"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを表示"
          }
        }
      }
    },
    "채팅 숨기기": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 숨기기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを非表示"
          }
        }
      }
    },
    "채팅 메뉴": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 메뉴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットメニュー"
          }
        }
      }
    }
  },
  "version": "1.0"
}
