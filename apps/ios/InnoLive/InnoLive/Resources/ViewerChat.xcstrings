{
  "sourceLanguage": "ko",
  "strings": {
    "채팅을 불러오지 못했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 불러오지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを読み込めませんでした。"
          }
        }
      }
    },
    "YouTube 방송을 시작하면 시청자 채팅을 볼 수 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 방송을 시작하면 시청자 채팅을 볼 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a YouTube broadcast to view audience chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube配信を開始すると視聴者チャットを表示できます。"
          }
        }
      }
    },
    "시청자 채팅은 YouTube 방송에서 지원합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자 채팅은 YouTube 방송에서 지원합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewer chat is available for YouTube broadcasts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者チャットはYouTube配信に対応しています。"
          }
        }
      }
    },
    "새 채팅을 기다리고 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 채팅을 기다리고 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for new messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャットを待っています。"
          }
        }
      }
    },
    "채팅을 연결하고 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 연결하고 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to chat…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットに接続しています…"
          }
        }
      }
    },
    "채팅 메뉴": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 메뉴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットメニュー"
          }
        }
      }
    }
  },
  "version": "1.0"
}
