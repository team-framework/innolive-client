{
  "sourceLanguage": "ko",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 방송 미리보기를 위해 카메라를 사용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to preview your live broadcast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ配信のプレビューにカメラを使用します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송에 사용자의 음성을 함께 송출하기 위해 마이크를 사용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to include your voice in the broadcast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信にあなたの声を含めるためにマイクを使用します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
