{
  "sourceLanguage": "ko",
  "strings": {
    "원본 영상 파일을 찾을 수 없습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 영상 파일을 찾을 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original recording could not be found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の録画ファイルが見つかりません。"
          }
        }
      }
    },
    "원본 영상에 영상과 음성 트랙이 모두 필요합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 영상에 영상과 음성 트랙이 모두 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original recording must include video and audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の録画には映像と音声の両方が必要です。"
          }
        }
      }
    },
    "이 파일의 분리 저장 형식을 지원하지 않습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일의 분리 저장 형식을 지원하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate export is not supported for this file format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイル形式は映像と音声の分離に対応していません。"
          }
        }
      }
    },
    "내보낸 파일을 확인하지 못했습니다. 다시 시도해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 파일을 확인하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported file could not be verified. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したファイルを確認できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "사진 앱에 저장하려면 사진 추가 권한을 허용해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 저장하려면 사진 추가 권한을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow adding to Photos to save the recording."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画を保存するには写真への追加を許可してください。"
          }
        }
      }
    },
    "영상과 음성 · MP4": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상과 음성 · MP4"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video with audio · MP4"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像と音声 · MP4"
          }
        }
      }
    },
    "영상·음성 분리 · MP4 + M4A": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상·음성 분리 · MP4 + M4A"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate video and audio · MP4 + M4A"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像と音声を分離 · MP4 + M4A"
          }
        }
      }
    },
    "내보낼 형식": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 형식"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し形式"
          }
        }
      }
    },
    "파일을 준비하는 중": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 준비하는 중"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを準備中"
          }
        }
      }
    },
    "취소": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "공유 또는 파일에 저장": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 또는 파일에 저장"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share or save to Files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有またはファイルに保存"
          }
        }
      }
    },
    "사진 앱에 저장": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 저장"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に保存"
          }
        }
      }
    },
    "사진 앱에 저장했어요": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 저장했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に保存しました"
          }
        }
      }
    },
    "형식을 다시 선택해 재시도할 수 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형식을 다시 선택해 재시도할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a format again to retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式を選び直して再試行できます。"
          }
        }
      }
    },
    "방송 영상 내보내기": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송 영상 내보내기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画の書き出し"
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "영상 · MP4": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 · MP4"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video · MP4"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像 · MP4"
          }
        }
      }
    },
    "음성 · M4A": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 · M4A"
          }
        },
        "en": {
