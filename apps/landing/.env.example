NEXT_PUBLIC_INNOLIVE_SERVER_URL=
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_DOWNLOAD_URL=

# InnoLive Video feature flag. Off unless exactly "1" or "true". Local builds default to off;
# the Docker image (production) defaults to true via the Dockerfile build arg.
NEXT_PUBLIC_INNOLIVE_VIDEO_ENABLED=
# Dev-only VOD mock. Requires NODE_ENV!=production AND the video flag above. Always ignored in
# production builds, even if set.
NEXT_PUBLIC_VOD_MOCK=

# Runtime-only settings. Never use NEXT_PUBLIC for the collector key.
EXPERIENCE_QUALITY_SERVER_URL=
EXPERIENCE_QUALITY_INGEST_KEY=
