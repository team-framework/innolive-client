<Window
    x:Class="InnoLive_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:InnoLive_Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InnoLive"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid RequestedTheme="Light">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="InnoLive">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
        </TitleBar>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
