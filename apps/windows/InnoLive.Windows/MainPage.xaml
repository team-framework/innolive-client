<Page
    x:Class="InnoLive_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:InnoLive_Windows.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Light">

    <Page.Resources>
        <DataTemplate x:Key="SceneTemplate" x:DataType="models:StudioSceneItem">
            <ToggleButton
                Tag="{x:Bind}"
                Click="Scene_Click"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                MinWidth="112"
                MinHeight="86"
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <Image Source="{x:Bind IconPath}" Width="28" Height="28" />
                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
        <DataTemplate x:Key="AudioTemplate" x:DataType="models:AudioChannelItem">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <Slider Minimum="0" Maximum="1" Value="{x:Bind Volume, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="210" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#0F1720" CornerRadius="4" MinHeight="160">
                    <Image Source="ms-appx:///Assets/Figma/preview-mountain.png" Stretch="UniformToFill" />
                </Border>
                <Border Grid.Column="1" Background="#0F1720" CornerRadius="4" MinHeight="160">
                    <Image Source="ms-appx:///Assets/Figma/preview-mountain.png" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#66000000" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE701;" Foreground="#0F7B0F" FontSize="11" />
                        <TextBlock Text="PING 30 ms" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Image Source="ms-appx:///Assets/Figma/on-air.png" Width="9" Height="9" />
                        <TextBlock Text="{x:Bind ViewModel.BroadcastStatusText, Mode=OneWay}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.LiveDuration, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Image Source="ms-appx:///Assets/Figma/on-air.png" Width="9" Height="9" />
                        <TextBlock Text="REC" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.RecordingDuration, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="ControlPanelsGrid" Grid.Row="2" ColumnSpacing="10" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="Compact">
                            <VisualState.Setters>
                                <Setter Target="SourcesPanel.(Grid.Row)" Value="1" />
                                <Setter Target="SourcesPanel.(Grid.Column)" Value="0" />
                                <Setter Target="SourcesPanel.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="AudioPanel.(Grid.Row)" Value="2" />
                                <Setter Target="AudioPanel.(Grid.Column)" Value="0" />
                                <Setter Target="AudioPanel.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="PanelRow1.Height" Value="210" />
                                <Setter Target="PanelRow2.Height" Value="210" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                    <RowDefinition x:Name="PanelRow1" Height="0" />
                    <RowDefinition x:Name="PanelRow2" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.88*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScenesPanel" Grid.Column="0" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="장면 편집" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons" Click="AddScene_Click" HorizontalAlignment="Right" ToolTipService.ToolTip="장면 추가" />
                        </Grid>
                        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Scenes}" ItemTemplate="{StaticResource SceneTemplate}" IsItemClickEnabled="False" SelectionMode="None" />
                        <ComboBox Grid.Row="2" ItemsSource="{x:Bind ViewModel.CameraDevices}" SelectedIndex="0" FontSize="12" />
                    </Grid>
                </Border>

                <Border x:Name="SourcesPanel" Grid.Column="1" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="소스 편집" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" ToolTipService.ToolTip="소스 추가">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="카메라" Tag="camera" Click="SourceType_Click" />
                                        <MenuFlyoutItem Text="화면 캡처" Tag="screen" Click="SourceType_Click" />
                                        <MenuFlyoutItem Text="텍스트" Tag="text" Click="SourceType_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sources}" SelectionMode="Single" SelectedIndex="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SourceItem">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" Padding="8,5" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ComboBox Grid.Row="2" ItemsSource="{x:Bind ViewModel.ScreenDevices}" SelectedIndex="0" FontSize="12" />
                    </Grid>
                </Border>

                <Border x:Name="AudioPanel" Grid.Column="2" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="오디오" FontSize="14" />
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.AudioChannels}" ItemTemplate="{StaticResource AudioTemplate}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                            <ToggleSwitch Header="비식별화" IsOn="{x:Bind ViewModel.IsAnonymizationEnabled, Mode=TwoWay}" />
                            <Button Content="{x:Bind ViewModel.RecordingButtonText, Mode=OneWay}" Click="Record_Click" />
                            <Button Content="{x:Bind ViewModel.BroadcastButtonText, Mode=OneWay}" Click="Broadcast_Click" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
