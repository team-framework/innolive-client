<Page
    x:Class="InnoLive_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:InnoLive_Windows.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Light">

    <Page.Resources>
        <DataTemplate x:Key="SceneTemplate" x:DataType="models:StudioSceneItem">
            <ToggleButton Tag="{x:Bind}" Click="Scene_Click" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="112" MinHeight="86" Padding="8">
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <Image Source="{x:Bind IconPath}" Width="28" Height="28" />
                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
        <DataTemplate x:Key="AudioTemplate" x:DataType="models:AudioChannelItem">
            <Grid ColumnSpacing="8" RowSpacing="3">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ToggleSwitch Tag="{x:Bind}" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Toggled="AudioEnabled_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="0">
                    <ProgressBar Maximum="1" Value="{x:Bind Level, Mode=OneWay}" Height="3" />
                    <Slider Minimum="0" Maximum="1" Value="{x:Bind Volume, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="210" /><RowDefinition Height="30" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#0F1720" CornerRadius="4" MinHeight="160">
                    <Grid>
                        <Image Source="ms-appx:///Assets/Figma/preview-mountain.png" Stretch="UniformToFill" />
                        <Border Background="#99000000" Padding="12,6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Visibility="{x:Bind ViewModel.PreviewOverlayVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.PreviewOverlayText, Mode=OneWay}" Foreground="White" FontSize="18" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#0F1720" CornerRadius="4" MinHeight="160">
                    <Grid>
                        <Image Source="ms-appx:///Assets/Figma/preview-mountain.png" Stretch="UniformToFill" />
                        <Border Background="#99000000" Padding="12,6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Visibility="{x:Bind ViewModel.PreviewOverlayVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.PreviewOverlayText, Mode=OneWay}" Foreground="White" FontSize="18" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#66000000" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="PING 30 ms" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.BroadcastStatusText, Mode=OneWay}" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.LiveDuration, Mode=OneWay}" FontSize="12" />
                    <TextBlock Text="REC" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.RecordingDuration, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ControlPanelsGrid" Grid.Row="2" ColumnSpacing="10" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers></VisualState>
                        <VisualState x:Name="Compact"><VisualState.Setters>
                            <Setter Target="SourcesPanel.(Grid.Row)" Value="1" /><Setter Target="SourcesPanel.(Grid.Column)" Value="0" /><Setter Target="SourcesPanel.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="AudioPanel.(Grid.Row)" Value="2" /><Setter Target="AudioPanel.(Grid.Column)" Value="0" /><Setter Target="AudioPanel.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="PanelRow1.Height" Value="250" /><Setter Target="PanelRow2.Height" Value="250" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions><RowDefinition Height="250" /><RowDefinition x:Name="PanelRow1" Height="0" /><RowDefinition x:Name="PanelRow2" Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><TextBlock Text="장면 편집" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="&#xE8AC;" FontFamily="Segoe Fluent Icons" Click="DuplicateScene_Click" ToolTipService.ToolTip="장면 복제" /><Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Click="RemoveScene_Click" ToolTipService.ToolTip="장면 삭제" /><Button Content="&#xE710;" FontFamily="Segoe Fluent Icons" Click="AddScene_Click" ToolTipService.ToolTip="장면 추가" /></StackPanel>
                        </Grid>
                        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Scenes}" ItemTemplate="{StaticResource SceneTemplate}" SelectionMode="None" />
                        <ComboBox Grid.Row="2" ItemsSource="{x:Bind ViewModel.CameraDevices}" SelectedIndex="0" FontSize="12" />
                    </Grid>
                </Border>

                <Border x:Name="SourcesPanel" Grid.Column="1" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><TextBlock Text="소스 편집" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="&#xE8A7;" FontFamily="Segoe Fluent Icons" Click="SourceBackward_Click" ToolTipService.ToolTip="뒤로" /><Button Content="&#xE8A7;" FontFamily="Segoe Fluent Icons" RenderTransformOrigin="0.5,0.5" Click="SourceForward_Click" ToolTipService.ToolTip="앞으로" /><Button Content="&#xE72E;" FontFamily="Segoe Fluent Icons" Click="SourceLock_Click" ToolTipService.ToolTip="잠금" /><Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Click="SourceRemove_Click" ToolTipService.ToolTip="삭제" />
                                <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons" ToolTipService.ToolTip="소스 추가"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="카메라" Tag="Camera" Click="SourceType_Click" /><MenuFlyoutItem Text="화면 캡처" Tag="Screen" Click="SourceType_Click" /><MenuFlyoutItem Text="텍스트" Tag="Text" Click="SourceType_Click" /><MenuFlyoutItem Text="이미지" Tag="Image" Click="SourceType_Click" /><MenuFlyoutItem Text="색상" Tag="Color" Click="SourceType_Click" /></MenuFlyout></Button.Flyout></Button>
                            </StackPanel>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sources}" SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}" SelectionChanged="SourceSelectionChanged">
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:SourceItem"><Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Tag="{x:Bind}" Content="&#xE890;" FontFamily="Segoe Fluent Icons" Click="SourceVisibility_Click" /><TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBox Grid.Row="2" Header="텍스트 소스" PlaceholderText="텍스트 소스를 선택하세요" Text="{x:Bind ViewModel.SelectedSourceText, Mode=OneWay}" TextChanged="SourceText_TextChanged" />
                        <ComboBox Grid.Row="3" Header="색상" SelectionChanged="SourceColor_SelectionChanged"><ComboBoxItem Content="파랑" Tag="#3478F6" /><ComboBoxItem Content="빨강" Tag="#C42B1C" /><ComboBoxItem Content="흰색" Tag="#FFFFFF" /></ComboBox>
                    </Grid>
                </Border>

                <Border x:Name="AudioPanel" Grid.Column="2" Background="#20FFFFFF" Padding="12" CornerRadius="4">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="오디오" FontSize="14" />
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.AudioChannels}" ItemTemplate="{StaticResource AudioTemplate}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><ToggleSwitch Header="비식별화" IsOn="{x:Bind ViewModel.IsAnonymizationEnabled, Mode=TwoWay}" /><Button Content="{x:Bind ViewModel.RecordingButtonText, Mode=OneWay}" Click="Record_Click" /><Button Content="{x:Bind ViewModel.BroadcastButtonText, Mode=OneWay}" Click="Broadcast_Click" Style="{StaticResource AccentButtonStyle}" /></StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
