{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innolive.app/contracts/signaling/v2.schema.json",
  "title": "InnoLive authenticated WebRTC signaling message",
  "type": "object",
  "required": ["type"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["offer", "answer", "ice_candidate", "ice_candidate_added", "error"]
    },
    "owner_token": { "type": "string", "minLength": 1 },
    "access_token": { "type": "string", "minLength": 1 },
    "sdp": { "type": "string", "minLength": 1 },
    "candidate": { "type": ["string", "null"] },
    "sdpMid": { "type": ["string", "null"] },
    "sdpMLineIndex": { "type": ["integer", "null"], "minimum": 0 },
    "end_of_candidates": { "type": "boolean" },
    "queued": { "type": "boolean" },
    "ice_connection_state": { "type": "string" },
    "connection_state": { "type": "string" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "offer" } }, "required": ["type"] },
      "then": { "required": ["session_id", "owner_token", "access_token", "sdp"] }
    },
    {
      "if": { "properties": { "type": { "const": "answer" } }, "required": ["type"] },
      "then": { "required": ["session_id", "sdp"] }
    },
    {
      "if": { "properties": { "type": { "const": "ice_candidate" } }, "required": ["type"] },
      "then": { "required": ["session_id", "owner_token", "access_token", "candidate"] }
    },
    {
      "if": { "properties": { "type": { "const": "ice_candidate_added" } }, "required": ["type"] },
      "then": {
        "required": [
          "session_id",
          "end_of_candidates",
          "queued",
          "ice_connection_state",
          "connection_state"
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "error" } }, "required": ["type"] },
      "then": { "required": ["error"] }
    }
  ]
}
